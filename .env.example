# 复制为 .env 后填写。不要把真实密钥提交到 Git。
# =============================================================================
# 模型选择
# =============================================================================
# local：连接本地 Ollama 服务（需先安装 Ollama 并拉取模型，见 OLLAMA_* 配置）
# openai：使用 OpenAI 兼容接口（推荐生产使用，语义质量更高）
LLAMAINDEX_MODEL_PROVIDER=local

# ---------- openai 模式必填 ----------
# 选择 openai 模式时必须填写；local 模式可留空。
OPENAI_API_KEY=

# ---------- openai 兼容可选 ----------
# 自定义 OpenAI 兼容服务地址（公司网关、第三方平台、本地部署如 vLLM/One API 等）。
# 只需填到 /v1 结尾，客户端会自动补全 /chat/completions、/embeddings 等路径。
# 留空或注释掉则走 OpenAI 官方地址 https://api.openai.com/v1
# 示例：OPENAI_API_BASE=https://your-gateway.example.com/v1
#OPENAI_API_BASE=https://ai2-api.i-tudou.com/v1

LLAMAINDEX_LLM_MODEL=gpt-4.1-mini
LLAMAINDEX_EMBED_MODEL=text-embedding-3-small

# ---------- local (Ollama) 模式配置（可选，均有默认值） ----------
# 选择 provider=local 时，qualityScheme/models.py 会连接 Ollama 服务。
# 需先安装 Ollama（https://ollama.com/download）并执行：
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
# 同时需要安装适配包：
#   pip install llama-index-llms-ollama llama-index-embeddings-ollama
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_LLM_MODEL=qwen2.5:7b
#OLLAMA_EMBED_MODEL=nomic-embed-text

# =============================================================================
# Milvus 向量库（qualityScheme 业务 必填，无默认值，代码中会运行时校验）
# =============================================================================
# 注意：为避免内部服务地址泄漏到代码中，从 2026-08-18 起 Milvus 连接
# 配置**必须在此显式填写**，qualityScheme/config.py 不再提供硬编码默认值。
QUALITY_MILVUS_URI=http://milvus-dev1.e-tudou.com:19530
QUALITY_MILVUS_DB=kernel_data_platform
QUALITY_MILVUS_COLLECTION=qualityScheme_llamaIndex

