# 复制为 .env 后填写。不要把真实密钥提交到 Git。
OPENAI_API_KEY=

# local：完全离线，便于学习流程；openai：使用真实模型获得更自然的回答。
LLAMAINDEX_MODEL_PROVIDER=local
LLAMAINDEX_LLM_MODEL=gpt-4.1-mini
LLAMAINDEX_EMBED_MODEL=text-embedding-3-small

# 可选：自定义 OpenAI 兼容服务地址（公司网关、第三方平台、本地部署等）。
# 只需填到 /v1 结尾，客户端会自动补全 /chat/completions、/embeddings 等路径。
# 留空或注释掉则走 OpenAI 官方地址 https://api.openai.com/v1
# 示例：OPENAI_API_BASE=https://your-gateway.example.com/v1
#OPENAI_API_BASE=https://ai2-api.i-tudou.com/v1

# qualityScheme 业务的 Milvus 向量库连接（免认证，直接连接）。
# 向量不再写本地 JSON，而是存入 Milvus 指定 collection。
QUALITY_MILVUS_URI=http://milvus-dev1.e-tudou.com:19530
QUALITY_MILVUS_DB=kernel_data_platform
QUALITY_MILVUS_COLLECTION=qualityScheme_llamaIndex

